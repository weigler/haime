rules_version = '2';

// Cada usuário só pode ler/escrever os próprios dados
// (users/{uid} e tudo dentro de users/{uid}/...).
// Cole isto em: Firebase Console → Firestore Database → Regras.

service cloud.firestore {
  match /databases/{database}/documents {

    // lista de e-mails autorizados a usar o app — só leitura pelo
    // cliente; edição é feita manualmente pelo console do Firebase.
    match /config/allowlist {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /logs/{logId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
